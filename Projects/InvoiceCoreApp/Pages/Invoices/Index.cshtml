@page
@model IndexModel
@inject InvoiceCoreApp.Services.InvoiceWriteStatus WriteStatus
@{
    ViewData["Title"] = "Invoices";
    var canWrite = WriteStatus.Snapshot.CanWriteInvoices;
}

<h1>Invoices</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<a class="btn btn-primary mb-2" data-invoice-write data-write-href="@Url.Page("Create")"
   href="@(canWrite ? Url.Page("Create") : null)" aria-disabled="@((!canWrite).ToString().ToLowerInvariant())"
   tabindex="@(canWrite ? null : "-1")">Add New Invoice</a>
<table class="table">
    <thead>
        <tr>
            <th>Description</th>
            <th>Due Date</th>
            <th>Supplier</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var invoice in Model.Invoices)
    {
        <tr>
            <td>@invoice.Description</td>
            <td>@invoice.DueDate.ToShortDateString()</td>
            <td>@invoice.Supplier</td>
            <td>
                <a class="btn btn-info btn-sm" asp-page="Details" asp-route-id="@invoice.Id">Details</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@invoice.Id" style="display:inline-block; margin-left:5px;" onsubmit="return confirm('Are you sure you want to delete this invoice?');">
                    <button type="submit" class="btn btn-danger btn-sm" data-invoice-write disabled="@(!canWrite)">Delete</button>
                </form>
            </td>   
        </tr>
    }
    </tbody>
</table>
